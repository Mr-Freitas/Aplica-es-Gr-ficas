:root {
    color: rgb(251, 247, 242);
    -unity-font-style: bold;
}

.main {
    width: 100%;
    height: 100%;

    background-color: rgb(251, 247, 242);

    flex-direction: column;
    justify-content: space-between;
    align-items: center;

    padding-top: 80px;
    padding-bottom: 50px;
}

.logo-container {
    flex-grow: 1;

    justify-content: center;
    align-items: center;
}

.logo {
    width: 220px;
    height: 512px;

    background-image: url("project://database/Assets/Art/UI/Backgrounds/Logo.png");

    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.buttons-container {
    width: 90%;

    flex-direction: column;
    gap: 32px;

    margin-bottom: 40px;
}

.btn-primary,
.btn-secondary {
    height: 128px;

    border-radius: 0;

    color: white;

    font-size: 32px;

    -unity-font-style: bold;
}

.btn-primary {
    background-color: rgb(195, 176, 211);
}

.btn-secondary {
    background-color: rgb(145, 177, 219);
}
/* =======================================================
   ESTILOS DOS CAMPOS DE TEXTO (LABELS DENTRO DO INPUT)
   ======================================================= */

.inputs-container {
    width: 90%;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 40px;
}

/* 1. Transformamos o container INTEIRO na nossa "caixa branca" */
.input-field {
    height: 96px;
    background-color: white;
    border-width: 4px;
    border-color: rgb(195, 176, 211); /* Borda combinando com o btn-primary */
    border-radius: 0;
    
    /* Alinha o label e o input lado a lado no centro vertical */
    flex-direction: row; 
    align-items: center;
    
    padding-left: 20px;
    padding-right: 20px;
}

/* 2. O texto "E-mail:" e "Senha:" agora vive dentro da caixa */
.input-field > .unity-text-field__label {
    width: 130px; /* Largura fixa para os textos ficarem alinhados */
    color: rgb(145, 177, 219); /* Azul do btn-secondary */
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    
    /* Removemos margens padrão do Unity para encaixar perfeito */
    min-width: 0; 
    padding: 0;
    margin: 0;
}

/* 3. A área de digitação fica invisível (transparente) e ocupa o resto do espaço */
.input-field > .unity-text-field__input {
    flex-grow: 1; /* Estica para preencher todo o espaço restante da caixa branca */
    background-color: transparent; /* Fundo transparente revela o branco do container */
    border-width: 0; /* Remove a borda interna */
    color: rgb(50, 50, 50); /* Cor escura para a digitação do usuário */
    font-size: 32px;
    padding: 0;
    margin: 0;
}

/* 4. Remove a bordinha azul padrão que o Unity coloca ao clicar para digitar */
.input-field > .unity-text-field__input:focus {
    background-color: transparent;
    border-width: 0;
}