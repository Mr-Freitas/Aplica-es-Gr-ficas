<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Home/HomeStyle.uss?fileID=7433441132597879392&amp;guid=e981e28a8372da2499b1d7d8cd6cfcbc&amp;type=3#HomeStyle"/>
    
    <ui:VisualElement name="main" class="main">
        <ui:VisualElement name="header" class="header">
            <ui:Label text="TELAS" name="title" class="title"/>
        </ui:VisualElement>
        
        <ui:VisualElement name="quick-tasks-card" class="card card--quick" style="height: 219px;">
            <ui:Label text="TAREFAS RÁPIDAS" class="card-title"/>
            <ui:TextField name="quick-task-input" placeholder-text="ADICIONAR UMA TAREFA" class="quick-task-input" style="height: 67px;"/>
            <ui:Button name="btn-add-home-task" text="ADICIONAR" class="btn-create-task" style="height: 50px; margin-top: 10px; font-size: 24px;"/>
        </ui:VisualElement>

        <ui:VisualElement name="tasks-card" class="card card--tasks" style="flex-grow: 1;">
            <ui:Label text="MESA DE TRABALHO DO USUÁRIO" class="card-title"/>
            <ui:ScrollView name="task-list" class="task-list" style="flex-grow: 1; margin-bottom: 10px;"/>
            <ui:Button name="btn-create-task" text="+ CRIAR NOVA MESA" class="btn-create-task" style="height: 67px; font-size: 32px;"/>
        </ui:VisualElement>
        
        <ui:VisualElement name="nav" class="nav">
            <ui:Button name="nav-home" class="nav-item nav-item--active">
                <ui:VisualElement class="nav-icon nav-icon--home"/>
                <ui:Label text="HOME" class="nav-label"/>
            </ui:Button>
            <ui:Button name="nav-quick-tasks" class="nav-item">
                <ui:VisualElement class="nav-icon nav-icon--tasks"/>
                <ui:Label text="TAREFAS" class="nav-label"/>
            </ui:Button>
            <ui:Button name="nav-calendar" class="nav-item">
                <ui:VisualElement class="nav-icon nav-icon--calendar"/>
                <ui:Label text="CALENDÁRIO" class="nav-label"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- MODAL DE CRIAÇÃO/EDIÇÃO -->
    <ui:VisualElement name="modal-workdesk" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.8); justify-content: center; align-items: center;">
        <ui:VisualElement style="background-color: white; padding: 40px; border-radius: 30px; width: 90%;">
            <ui:Label name="modal-title" text="NOVA MESA DE TRABALHO" style="font-size: 48px; -unity-font-style: bold; margin-bottom: 30px; color: black; -unity-text-align: middle-center;"/>
            
            <ui:TextField name="input-wd-title" label="Título" style="font-size: 32px; margin-bottom: 25px; color: black;"/>
            <ui:TextField name="input-wd-description" label="Descrição" multiline="true" style="font-size: 32px; margin-bottom: 25px; color: black; height: 150px;"/>
            <ui:TextField name="input-wd-date" label="Data (DD/MM/AAAA)" style="font-size: 32px; margin-bottom: 25px; color: black;"/>
            <ui:DropdownField name="dropdown-wd-priority" label="Prioridade" choices="Alta,Média,Baixa" style="font-size: 32px; margin-bottom: 40px; color: black;"/>
            
            <ui:Button name="btn-save-wd" text="SALVAR" style="height: 100px; font-size: 36px; background-color: rgb(33, 150, 243); color: white; -unity-font-style: bold; margin-bottom: 20px; border-radius: 15px;"/>
            <ui:Button name="btn-cancel-wd" text="CANCELAR" style="height: 100px; font-size: 36px; background-color: rgb(244, 67, 54); color: white; -unity-font-style: bold; border-radius: 15px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>